    const wrap = el('div', animate ? 'bean-swap' : '');
    const roast = el('p', 'bean__roast'); roast.append(el('span', '', b.roast), el('i', '', b.en));
    const chips = el('ul', 'notes-chips'); b.notes.forEach(n => chips.appendChild(el('li', '', n)));
    const dl = el('dl', 'bean__profile');
    b.profile.forEach(([k, v]) => {
      const d = el('div');
      d.append(el('dt', '', k), el('dd', '', v)); dl.appendChild(d);
    });
    const rec = el('div', 'bean__rec'); rec.append(el('b', '', 'おすすめ'), el('p', '', b.rec));
    wrap.append(roast, el('h3', 'bean__name', b.name), el('p', 'bean__en', b.country), el('p', 'bean__lot', b.lot),
      el('p', 'bean__h', 'CUPPING NOTES'), chips, dl,
      el('p', 'bean__h', 'STORY'), el('p', 'bean__p', b.story),
      el('p', 'bean__h', 'PROCESS'), el('p', 'bean__p', b.process), rec);
    beanDetail.innerHTML = ''; beanDetail.appendChild(wrap);
    if (animate && !reduce) { beanArt.classList.remove('is-hop'); void beanArt.offsetWidth; beanArt.classList.add('is-hop'); }
  }
  roastRange.addEventListener('input', () => renderBean(+roastRange.value, true));
  $$('.picker button', beansSec).forEach(btn => btn.addEventListener('click', () => renderBean(+btn.dataset.i, true)));
  beanArt.addEventListener('click', () => renderBean((+roastRange.value + 1) % 3, true));
  renderBean(1, false);

  /* ---------- GAME 01：ぴったり注ぐ ---------- */
  const cup = $('#cup'), liquid = $('#liquid'), waveG = $('#waveG'), stream = $('#stream');
  const pourBtn = $('#pourBtn'), pourMsg = $('#pourMsg'), pourBest = $('#pourBest');
  const TOP = 70, BOT = 272, H = BOT - TOP;   // 注ぎ口の高さ
  const LO = (BOT - 120) / H, HI = (BOT - 102) / H, MID = (LO + HI) / 2; // 点線の間
  const pour = { level: 0, on: false, done: false, t0: 0, last: 0, raf: 0 };
  let best = parseInt(store.get('katarizu-best') || '0', 10);
  const showBest = () => { pourBest.textContent = `BEST — ${best ? best + '%' : '--'}`; };
  showBest();
  function drawCup() {
    const lv = Math.min(pour.level, 1.04);
    const y = BOT - lv * H;
    liquid.setAttribute('y', y.toFixed(1));
    waveG.setAttribute('transform', `translate(0 ${(y - 7).toFixed(1)})`);
    stream.setAttribute('height', pour.on ? Math.max(0, y).toFixed(1) : 0);
  }
  function pourReset() {
    pour.level = 0; pour.done = false; cup.classList.remove('is-over'); drawCup();
    pourMsg.textContent = '点線の間で止められたら、バリスタ級。';
    pourBtn.textContent = '長押しで注ぐ';
  }
  function pourTick(now) {
    if (!pour.on) return;
    const dt = Math.min(0.05, (now - pour.last) / 1000); pour.last = now;
    const held = (now - pour.t0) / 1000;
    pour.level += (0.2 + held * 0.17) * dt;
    drawCup();
    if (pour.level >= 1.04) { pourStop(); return; }
    pour.raf = requestAnimationFrame(pourTick);
  }
  function pourStart(e) {
    if (e) e.preventDefault();
    if (pour.on) return;
    if (pour.done) pourReset();
    pour.on = true; pour.t0 = pour.last = performance.now();
    pourBtn.classList.add('is-active');
    pourMsg.textContent = 'そそいでます…';
    pour.raf = requestAnimationFrame(pourTick);
  }
  function pourStop() {
    if (!pour.on) return;
    pour.on = false; cancelAnimationFrame(pour.raf);
    pourBtn.classList.remove('is-active');
    drawCup();
    const lv = pour.level;
    let score = Math.max(0, Math.round(100 - Math.abs(lv - MID) * 450));
    let head, sub;
    if (lv >= 1) { head = 'あふれた〜！'; sub = '布巾、持ってきて！'; score = 0; cup.classList.add('is-over'); }
    else if (lv > HI) { head = 'ちょっと多め！'; sub = 'こぼさないように、そ〜っと。'; }
    else if (lv >= LO) { head = score >= 94 ? 'ジャスト！' : 'ぴったり！'; sub = score >= 94 ? '先生もびっくりのバリスタ級。' : 'いい腕してます。'; }
    else if (lv >= 0.45) { head = 'あとひと注ぎ…！'; sub = 'もう少しだけ、遠慮しないで。'; }
    else { head = 'まだまだ！'; sub = '長押しで、たっぷり注いでね。'; }
    pourMsg.innerHTML = '';
    const s1 = document.createElement('strong'); s1.textContent = head;
    pourMsg.append(s1, document.createTextNode(`${sub}（ぴったり度 ${score}%）`));
    if (score > best) { best = score; store.set('katarizu-best', String(best)); showBest(); }
    pour.done = true;
    pourBtn.textContent = 'もう一杯（長押し）';
  }
  pourBtn.addEventListener('pointerdown', e => { pourBtn.setPointerCapture(e.pointerId); pourStart(e); });
  pourBtn.addEventListener('pointerup', pourStop);
  pourBtn.addEventListener('pointercancel', pourStop);
  pourBtn.addEventListener('lostpointercapture', pourStop);
  pourBtn.addEventListener('contextmenu', e => e.preventDefault());
  pourBtn.addEventListener('keydown', e => { if ((e.key === ' ' || e.key === 'Enter') && !e.repeat) pourStart(e); });
  pourBtn.addEventListener('keyup', e => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); pourStop(); } });
  pourBtn.addEventListener('blur', pourStop);
  drawCup();

  /* ---------- カウントダウン ---------- */
  const pad2 = n => String(n).padStart(2, '0');
  const cd = { label: $('#cdLabel'), nums: $('#cdNums'), d: $('#cdD'), h: $('#cdH'), m: $('#cdM'), s: $('#cdS') };
  function countdown() {
    const now = Date.now();
    const open = EVENT.sessions.find(x => now >= x.start.getTime() && now < x.end.getTime());
    const next = EVENT.sessions.find(x => now < x.start.getTime());
    if (open) {
      cd.label.textContent = 'ただいま営業中！ 本館3階 調理室へ（16:00まで）'; cd.nums.hidden = true;
    } else if (next) {
      let t = Math.floor((next.start.getTime() - now) / 1000);
      const d = Math.floor(t / 86400); t -= d * 86400;
      const h = Math.floor(t / 3600); t -= h * 3600;
      const m = Math.floor(t / 60); const sec = t - m * 60;
      cd.label.textContent = next === EVENT.sessions[0] ? '開店まで' : '2日目の開店まで';
      cd.nums.hidden = false;
      cd.d.textContent = d; cd.h.textContent = pad2(h); cd.m.textContent = pad2(m); cd.s.textContent = pad2(sec);
    } else {
      cd.label.textContent = 'ご来店ありがとうございました！'; cd.nums.hidden = true;
    }
  }
  countdown(); setInterval(countdown, 1000);
})();
</script>
