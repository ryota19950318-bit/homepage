<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>語りーず珈琲｜学園祭限定 リハ教員の自家焙煎コーヒースタンド</title>
<meta name="description" content="リハ教員が提供する自家焙煎珈琲「語りーず珈琲」。学園祭の2日間だけ、本館3階 調理室にオープン。">
<meta name="theme-color" content="#2A1810">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&family=Noto+Sans+JP:wght@400;500;700;900&family=Noto+Serif+JP:wght@700;900&display=swap" rel="stylesheet">
<script>document.documentElement.classList.add('js');</script>
<style>
/* =========================================================
   語りーず珈琲 — 学園祭特設サイト
   配色・書体はポスターから継承
   ========================================================= */
:root{
  --paper:#F3EDE3; --paper2:#E9DFD0; --paper3:#DDCFBA;
  --ink:#2A1810; --ink2:#5A4636; --ink3:#36231A;
  --red:#B93426; --red2:#9A2A1E; --red-on-dark:#EE8A73;
  --cream:#FBF3E4; --line:rgba(42,24,16,.16);
  --serif:"Noto Serif JP","Hiragino Mincho ProN","Yu Mincho",serif;
  --sans:"Noto Sans JP","Hiragino Kaku Gothic ProN","Yu Gothic",Meiryo,sans-serif;
  --latin:"Inter","Noto Sans JP",system-ui,sans-serif;
  --ease:cubic-bezier(.2,.8,.2,1);
  --hdr:72px;
  --pad:clamp(20px,5vw,72px);
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-padding-top:calc(var(--hdr) + 12px)}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.85;overflow-x:hidden;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit}
button,input,textarea,select{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--red);outline-offset:3px;border-radius:4px}
.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.wrap{width:min(1200px, calc(100% - var(--pad)*2));margin-inline:auto}
/* paper grain */
body::before{content:"";position:fixed;inset:0;z-index:200;pointer-events:none;opacity:.22;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .16  0 0 0 0 .09  0 0 0 0 .06  0 0 0 .5 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}

/* ---------- common parts ---------- */
.label{display:flex;align-items:center;gap:12px;margin:0;font-family:var(--latin);font-size:12px;font-weight:700;letter-spacing:.32em;color:var(--red);text-transform:uppercase}
.label::before{content:"";width:36px;height:2px;background:currentColor}
.h2{font-family:var(--serif);font-weight:900;font-size:clamp(34px,5.4vw,76px);line-height:1.2;letter-spacing:.01em;margin:.35em 0 .45em;text-wrap:balance}
.lead{font-size:clamp(15px,1.4vw,18px);font-weight:500;max-width:36em;margin:0;text-wrap:pretty}
.section{padding:clamp(96px,12vw,180px) 0;position:relative}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 28px;border-radius:999px;border:1.5px solid var(--ink);background:transparent;font-weight:700;font-size:15px;letter-spacing:.04em;text-decoration:none;cursor:pointer;transition:transform .25s var(--ease),background .25s,color .25s,border-color .25s;-webkit-tap-highlight-color:transparent}
.btn:hover{transform:translateY(-2px)}
.btn:active{transform:translateY(0) scale(.98)}
.btn--red{background:var(--red);border-color:var(--red);color:#fff}
.btn--red:hover{background:var(--red2);border-color:var(--red2)}
.btn--ink{background:var(--ink);color:var(--cream)}
.btn--ink:hover{background:#000}
.btn--cream{border-color:var(--cream);color:var(--cream)}
.btn--cream:hover{background:var(--cream);color:var(--ink)}
.btn svg{flex:none}
.btn[disabled]{opacity:.5;cursor:not-allowed;transform:none}
.pill{display:inline-flex;align-items:center;gap:8px;padding:6px 16px;border:1.5px solid currentColor;border-radius:999px;font-size:14px;font-weight:700;line-height:1.5}
.nw{display:inline-block}

/* reveal on scroll */
.js .reveal{opacity:0;transform:translateY(42px);transition:opacity 1s var(--ease),transform 1.1s var(--ease);transition-delay:var(--d,0s)}
.js .reveal.is-in{opacity:1;transform:none}

/* ---------- progress & header ---------- */
.progress{position:fixed;top:0;left:0;right:0;height:3px;z-index:120;background:var(--red);transform-origin:0 50%;transform:scaleX(0)}
.hdr{position:fixed;top:0;left:0;right:0;z-index:100;height:var(--hdr);display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 var(--pad);transition:background .35s,box-shadow .35s,height .35s}
.hdr.is-solid{background:rgba(243,237,227,.9);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);box-shadow:0 1px 0 var(--line);height:60px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-family:var(--serif);font-weight:900;font-size:17px;letter-spacing:.14em;white-space:nowrap}
.brand img{width:46px;height:36px;object-fit:contain}
.nav{display:flex;align-items:center;gap:clamp(16px,2.4vw,32px)}
.nav a:not(.btn){font-family:var(--latin);font-size:12px;font-weight:700;letter-spacing:.24em;text-decoration:none;position:relative;padding:6px 0}
.nav a:not(.btn)::after{content:"";position:absolute;left:0;right:100%;bottom:0;height:2px;background:var(--red);transition:right .3s var(--ease)}
.nav a:not(.btn):hover::after{right:0}
.nav .btn{min-height:44px;padding:0 20px;font-size:14px}
.burger{display:none;width:48px;height:48px;border:0;border-radius:50%;background:var(--ink);cursor:pointer;position:relative}
.burger span{position:absolute;left:14px;right:14px;height:2px;background:var(--cream);transition:transform .3s var(--ease),opacity .2s}
.burger span:nth-child(1){top:19px}.burger span:nth-child(2){top:27px}
.nav-open .burger span:nth-child(1){transform:translateY(4px) rotate(45deg)}
.nav-open .burger span:nth-child(2){transform:translateY(-4px) rotate(-45deg)}

/* ---------- HERO ---------- */
.hero{position:relative;min-height:100vh;min-height:100svh;overflow:hidden;background:var(--paper)}
.hero__photo{position:absolute;top:0;right:0;bottom:0;width:56%;overflow:hidden;clip-path:inset(0 0 0 100%);transition:clip-path 1.5s var(--ease) .1s;background:var(--paper2)}
.is-loaded .hero__photo{clip-path:inset(0 0 0 0)}
.hero__photo-inner{position:absolute;inset:-8% 0;will-change:transform}
.hero__photo img{width:100%;height:100%;object-fit:cover;object-position:50% 42%;transform:scale(1.14);transition:transform 2.6s var(--ease) .1s}
.is-loaded .hero__photo img{transform:scale(1)}
.hero__copy{position:relative;z-index:3;min-height:100vh;min-height:100svh;display:flex;flex-direction:column;justify-content:center;padding:calc(var(--hdr) + 32px) var(--pad) 120px}
.hero__eyebrow{display:flex;flex-wrap:wrap;gap:6px 18px;margin:0 0 6px;font-size:13px;font-weight:700;letter-spacing:.14em;max-width:44vw}
.hero__eyebrow span:first-child{font-family:var(--latin);font-size:12px;letter-spacing:.32em;color:var(--red)}
.hero__title{font-family:var(--serif);font-weight:900;font-size:clamp(60px,10.6vw,196px);line-height:1.04;letter-spacing:-.01em;margin:.06em 0 .12em -.04em;white-space:nowrap;cursor:default;user-select:none}
.char{display:inline-block;opacity:0;transform:translateY(.8em) rotate(8deg);transition:transform 1.1s var(--ease),opacity .9s ease;transition-delay:calc(var(--i) * 75ms + .45s)}
.is-loaded .char{opacity:1;transform:none}
.char__in{display:inline-block;transition:translate .4s var(--ease),scale .4s var(--ease),color .3s}
.char--q .char__in{color:var(--red);transform-origin:50% 90%;animation:bob 2.8s ease-in-out 2s infinite}
@keyframes bob{0%,100%{rotate:0deg}30%{rotate:-10deg}60%{rotate:6deg}}
.hero__sub{display:flex;align-items:center;gap:16px;margin:0 0 28px;min-height:1.5em;font-family:var(--serif);font-weight:900;font-size:clamp(22px,2.7vw,42px);color:var(--red);line-height:1.3}
.hero__sub .rule{flex:none;width:54px;height:2px;background:currentColor}
.typed::after{content:"";display:inline-block;width:2px;height:.95em;margin-left:5px;vertical-align:-.1em;background:currentColor;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
.hero__meta{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 30px;padding:0;list-style:none;max-width:min(560px,42vw)}
.hero__meta li{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border:1.5px solid var(--ink);border-radius:999px;font-size:14px;font-weight:700;background:rgba(243,237,227,.6)}
.hero__meta svg{flex:none}
.hero__cta{display:flex;flex-wrap:wrap;gap:12px}
.badge{position:absolute;z-index:4;left:calc(44% - 96px);bottom:11vh;width:192px;height:192px;pointer-events:none}
.badge__ring{width:100%;height:100%;will-change:transform;filter:drop-shadow(0 12px 24px rgba(42,24,16,.3))}
.badge__ring text{font-family:var(--latin);font-weight:700;font-size:14.5px;letter-spacing:.06em;fill:#fff}
.badge__logo{position:absolute;left:50%;top:50%;width:98px;transform:translate(-50%,-50%)}
.scrollcue{position:absolute;z-index:4;left:var(--pad);bottom:28px;display:flex;align-items:center;gap:12px;font-family:var(--latin);font-size:11px;font-weight:700;letter-spacing:.3em;text-decoration:none}
.scrollcue i{display:block;width:64px;height:1.5px;background:var(--line);position:relative;overflow:hidden}
.scrollcue i::after{content:"";position:absolute;inset:0;background:var(--ink);transform:translateX(-100%);animation:cue 2s var(--ease) infinite}
@keyframes cue{60%,100%{transform:translateX(100%)}}

/* ---------- marquee ---------- */
.marquee{background:var(--ink);color:var(--cream);overflow:hidden;padding:20px 0;border-block:1px solid #000}
.marquee__track{display:flex;width:max-content;will-change:transform}
.marquee__item{display:flex;align-items:center;gap:36px;padding-right:36px;white-space:nowrap;font-family:var(--serif);font-weight:900;font-size:clamp(22px,3.2vw,44px);line-height:1.2}
.marquee__item em{font-style:normal;color:var(--red-on-dark)}
.bean{flex:none;width:.7em;height:.7em}

/* ---------- concept ---------- */
.concept__grid{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(40px,6vw,96px);align-items:center}
.fill{font-family:var(--serif);font-weight:900;font-size:clamp(26px,3.5vw,52px);line-height:1.65;letter-spacing:.02em;margin:.6em 0 0}
.fill .c{opacity:.16;transition:opacity .3s ease}
.fill .c.on{opacity:1}
.photos{position:relative;aspect-ratio:4/4.6}
.polaroid{position:absolute;margin:0;background:#FDFCF8;padding:10px 10px 44px;box-shadow:0 2px 4px rgba(42,24,16,.12),0 30px 50px -18px rgba(42,24,16,.45)}
.polaroid img{width:100%;height:100%;object-fit:cover}
.polaroid figcaption{position:absolute;left:14px;right:14px;bottom:10px;font-family:var(--serif);font-weight:700;font-size:14px;line-height:1.6}
.polaroid--a{left:0;top:4%;width:92%;aspect-ratio:1.5/1;rotate:-4deg}
.polaroid--a img{height:calc(100% - 0px)}
.polaroid--b{right:0;bottom:0;width:52%;aspect-ratio:4/5.6;rotate:5deg}
.points{list-style:none;margin:clamp(72px,9vw,120px) 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}
.points li{border-top:2px solid var(--ink);padding-top:22px}
.points b{display:block;font-family:var(--latin);font-size:13px;letter-spacing:.24em;color:var(--red);margin-bottom:6px}
.points h3{font-family:var(--serif);font-weight:900;font-size:clamp(22px,2.2vw,28px);margin:0 0 8px;line-height:1.4}
.points p{margin:0;font-size:15px}

/* ---------- menu (HOT / ICE) ---------- */
.menu{--accent:var(--red);--bg:var(--paper2);background:var(--bg);transition:background-color .7s var(--ease)}
.menu[data-mode="ice"]{--accent:#2C4A68;--bg:#E2E8EA}
.menu .label{color:var(--accent);transition:color .5s}
.menu__head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:clamp(36px,5vw,64px)}
.toggle{position:relative;display:inline-grid;grid-template-columns:1fr 1fr;padding:6px;border-radius:999px;background:var(--ink);isolation:isolate}
.toggle button{position:relative;z-index:1;min-width:112px;min-height:52px;padding:0 22px;border:0;border-radius:999px;background:transparent;color:rgba(251,243,228,.7);font-family:var(--latin);font-weight:700;font-size:16px;letter-spacing:.2em;cursor:pointer;transition:color .3s}
.toggle button[aria-pressed="true"]{color:#fff}
.toggle__knob{position:absolute;z-index:0;top:6px;bottom:6px;left:6px;width:calc(50% - 6px);border-radius:999px;background:var(--accent);transition:transform .5s var(--ease),background .5s}
.menu[data-mode="ice"] .toggle__knob{transform:translateX(100%)}
.menu__grid{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:clamp(36px,6vw,96px);align-items:center}
.menu__media{position:relative;aspect-ratio:4/5;border-radius:28px;overflow:visible;cursor:pointer}
.menu__frame{position:absolute;inset:0;border-radius:28px;overflow:hidden;box-shadow:0 40px 70px -30px rgba(42,24,16,.55);transform:rotate(-2deg);transition:transform .7s var(--ease)}
.menu[data-mode="ice"] .menu__frame{transform:rotate(2deg)}
.menu__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .7s var(--ease),transform 1.2s var(--ease)}
.menu[data-mode="hot"] .menu__img--ice,.menu[data-mode="ice"] .menu__img--hot{opacity:0;transform:scale(1.08)}
.steam{position:absolute;left:30%;top:-3%;width:40%;height:20%;z-index:2;pointer-events:none;transition:opacity .6s}
.menu[data-mode="ice"] .steam{opacity:0}
.steam path{fill:none;stroke:rgba(255,255,255,.95);stroke-width:5;stroke-linecap:round;filter:drop-shadow(0 0 6px rgba(42,24,16,.25));opacity:0;animation:steam 3.6s ease-in-out infinite}
.steam path:nth-child(2){animation-delay:1.2s}.steam path:nth-child(3){animation-delay:2.4s}
@keyframes steam{0%{opacity:0;transform:translateY(30px) scaleY(.8)}35%{opacity:.85}100%{opacity:0;transform:translateY(-40px) scaleY(1.15)}}
.bubbles{position:absolute;inset:0;overflow:hidden;border-radius:28px;pointer-events:none;transition:opacity .6s}
.menu[data-mode="hot"] .bubbles{opacity:0}
.bubbles span{position:absolute;bottom:-20px;width:var(--s);height:var(--s);border-radius:50%;border:1.5px solid rgba(255,255,255,.85);background:rgba(255,255,255,.18);left:var(--x);animation:rise var(--t) linear var(--dl) infinite}
@keyframes rise{to{transform:translateY(-120vh) translateX(20px)}}
.menu__name{font-family:var(--latin);font-weight:700;font-size:clamp(56px,9vw,140px);line-height:.95;letter-spacing:-.03em;margin:0;color:var(--accent);transition:color .5s}
.menu__jp{font-family:var(--serif);font-weight:900;font-size:clamp(24px,2.6vw,34px);margin:.4em 0 .6em}
.menu__desc{margin:0 0 28px;font-size:16px;max-width:30em}
.price{display:grid;grid-template-columns:1fr 1fr;border-top:2px solid var(--ink);border-bottom:2px solid var(--ink)}
.price div{padding:18px 4px}
.price div+div{border-left:1px solid var(--line);padding-left:24px}
.price dt{font-size:13px;font-weight:700;letter-spacing:.12em}
.price dd{margin:0;font-family:var(--latin);font-weight:700;font-size:clamp(38px,4.6vw,58px);line-height:1.1;letter-spacing:-.02em}
.price dd small{font-size:.4em;margin-left:2px}
.menu__note{font-size:13px;color:var(--ink2);margin:14px 0 0}
.menu__hint{display:inline-flex;align-items:center;gap:8px;margin-top:22px;font-size:13px;font-weight:700}
.swap{animation:swap .6s var(--ease)}
@keyframes swap{from{opacity:0;transform:translateY(14px)}}

/* ---------- play (dark) ---------- */
.play{background:var(--ink);color:var(--cream);overflow:hidden}
.play .label{color:var(--red-on-dark)}
.play .lead{color:rgba(251,243,228,.86)}
.toys{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(20px,3vw,32px);margin-top:clamp(40px,5vw,64px)}
.toy{background:var(--ink3);border:1px solid rgba(251,243,228,.12);border-radius:28px;padding:clamp(22px,3vw,36px);display:flex;flex-direction:column;gap:18px}
.toy h3{font-family:var(--serif);font-weight:900;font-size:clamp(24px,2.4vw,32px);margin:0;line-height:1.35}
.toy p{margin:0;font-size:15px;color:rgba(251,243,228,.84)}
.toy__num{font-family:var(--latin);font-size:12px;font-weight:700;letter-spacing:.3em;color:var(--red-on-dark)}
/* pour game */
.pour{display:grid;place-items:center;padding:8px 0}
.pour svg{width:min(100%,280px);height:auto;overflow:visible}
.cup-glass{fill:rgba(251,243,228,.06);stroke:rgba(251,243,228,.9);stroke-width:3}
.cup.is-over .drip{animation:drip 1.2s ease-in infinite}
.drip{opacity:0}
@keyframes drip{0%{opacity:1;transform:translateY(0)}100%{opacity:0;transform:translateY(60px)}}
.target line{stroke:var(--red-on-dark);stroke-width:2.5;stroke-dasharray:6 6}
.target text{fill:var(--red-on-dark);font-family:var(--sans);font-weight:700;font-size:12px}
.wave{animation:wave 1.6s linear infinite}
@keyframes wave{to{transform:translateX(-40px)}}
.hold{position:relative;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;touch-action:none}
.hold.is-active{background:var(--red2);transform:scale(.97)}
.result{min-height:3.4em;font-weight:700;font-size:15px;color:var(--cream)!important;text-align:center}
.result strong{display:block;font-family:var(--serif);font-size:22px;color:var(--red-on-dark)}
.best{font-family:var(--latin);font-size:12px;letter-spacing:.2em;text-align:center;color:rgba(251,243,228,.7)!important}
/* setlog promo */
.promo{position:relative;background:var(--cream);color:var(--ink);border-radius:28px;padding:clamp(22px,3vw,36px);display:flex;flex-direction:column;gap:16px;box-shadow:0 30px 60px -30px rgba(0,0,0,.6)}
.promo__head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}
.promo__live{white-space:nowrap;display:inline-flex;align-items:center;gap:8px;margin:0 0 12px;padding:4px 12px;border-radius:999px;background:var(--red);color:#fff;font-family:var(--latin);font-size:12px;font-weight:700;letter-spacing:.18em}
.promo__live .dot{width:8px;height:8px;border-radius:50%;background:#fff;animation:pulse 1.4s ease-in-out infinite}
@keyframes pulse{50%{opacity:.25;transform:scale(.7)}}
.promo h3{font-family:var(--serif);font-weight:900;font-size:clamp(26px,2.8vw,36px);line-height:1.35;margin:0}
.promo p{margin:0;font-size:15px}
.promo__fan{position:relative;flex:none;width:150px;height:140px}
.promo__fan img{position:absolute;width:84px;height:105px;object-fit:cover;border:5px solid #fff;border-radius:8px;box-shadow:0 10px 18px -6px rgba(42,24,16,.45)}
.promo__fan img:nth-child(1){left:0;top:18px;rotate:-12deg}
.promo__fan img:nth-child(2){left:34px;top:6px;rotate:4deg}
.promo__fan img:nth-child(3){left:62px;top:24px;rotate:14deg}
.promo__join{display:grid;grid-template-columns:auto 1fr;gap:20px;align-items:center;padding:16px;border-radius:20px;background:var(--paper2)}
.promo__qr{background:#fff;border-radius:14px;padding:10px;text-align:center}
.promo__qr img{width:128px;height:128px;image-rendering:pixelated}
.promo__qr small{display:block;font-size:11px;font-weight:700;letter-spacing:.2em}
.promo__qr b{display:block;font-family:var(--latin);font-size:20px;letter-spacing:.08em;line-height:1.2}
.promo__steps{margin:0;padding:0;list-style:none;counter-reset:p;display:grid;gap:10px}
.promo__steps li{counter-increment:p;display:grid;grid-template-columns:28px 1fr;gap:10px;font-size:14px;font-weight:700;line-height:1.6}
.promo__steps li::before{content:counter(p);display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:var(--ink);color:var(--cream);font-family:var(--latin);font-size:12px}
.promo__view{font-weight:900;color:var(--red)}
.promo__cta{display:flex;flex-wrap:wrap;gap:10px}
.promo p.promo__fine{font-size:13px;color:var(--ink2)}

/* ---------- scenes (horizontal) ---------- */
.scenes{position:relative;background:var(--paper)}
.scenes__sticky{position:relative;padding:clamp(96px,12vw,160px) 0}
.pin-on .scenes__sticky{position:sticky;top:0;height:100vh;padding:0;display:flex;flex-direction:column;justify-content:center;overflow:hidden}
.scenes__head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:clamp(24px,3vw,40px)}
.scenes__head .h2{margin-bottom:0}
.scenes__track{display:flex;align-items:center;gap:clamp(18px,2.4vw,32px);width:max-content;padding:0 var(--pad);will-change:transform}
.scene{margin:0;flex:none;position:relative}
.scene img{width:100%;height:100%;object-fit:cover;border-radius:22px}
.scene figcaption{margin-top:10px;font-size:13px;font-weight:700;display:flex;gap:10px}
.scene figcaption b{font-family:var(--latin);color:var(--red);letter-spacing:.12em}
.scene--tall{width:clamp(220px,26vw,360px);height:clamp(280px,34vw,450px)}
.scene--wide{width:clamp(320px,46vw,680px);height:clamp(180px,24vw,340px)}
.scene--sq{width:clamp(220px,24vw,320px);height:clamp(220px,24vw,320px)}
.scene--text{width:clamp(240px,26vw,360px);height:clamp(280px,34vw,450px);border-radius:22px;background:var(--red);color:#fff;display:flex;flex-direction:column;justify-content:space-between;padding:28px}
.scene--text p{margin:0;font-family:var(--serif);font-weight:900;font-size:clamp(34px,3.6vw,52px);line-height:1.2}
.scene--text span{font-family:var(--latin);font-size:12px;font-weight:700;letter-spacing:.3em}
.scene--logo{width:clamp(220px,24vw,320px);height:clamp(220px,24vw,320px);border-radius:50%;background:var(--ink);display:grid;place-items:center}
.scene--logo img{width:76%;height:auto;object-fit:contain;border-radius:0}
.scene:not(.scene--text):not(.scene--logo){transition:rotate .5s var(--ease)}
.scene:nth-child(odd){rotate:-1.5deg}.scene:nth-child(even){rotate:1.5deg}
.scene:hover{rotate:0deg}

/* ---------- info ---------- */
.info{background:var(--paper2)}
.dates{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2px;margin:clamp(28px,4vw,48px) 0;background:var(--ink);border:2px solid var(--ink);border-radius:28px;overflow:hidden}
.date{background:var(--paper2);padding:clamp(22px,3vw,40px);display:flex;flex-direction:column;gap:4px}
.date__day{font-family:var(--latin);font-weight:700;font-size:clamp(64px,11vw,160px);line-height:.9;letter-spacing:-.04em}
.date__day sup{font-size:.22em;letter-spacing:.12em;vertical-align:top;margin-left:10px;color:var(--red)}
.date__time{font-family:var(--latin);font-weight:600;font-size:clamp(16px,1.6vw,20px);letter-spacing:.08em}
.countdown{display:flex;flex-wrap:wrap;align-items:center;gap:clamp(16px,3vw,40px);padding:clamp(20px,3vw,32px);border-radius:28px;background:var(--ink);color:var(--cream)}
.countdown__label{font-family:var(--serif);font-weight:900;font-size:clamp(20px,2vw,26px)}
.countdown__nums{display:flex;gap:clamp(10px,2vw,28px)}
.countdown__nums div{display:flex;align-items:baseline;gap:4px}
.countdown__nums b{font-family:var(--latin);font-weight:700;font-variant-numeric:tabular-nums;font-size:clamp(36px,5vw,64px);line-height:1}
.countdown__nums span{font-size:13px;font-weight:700}
.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 clamp(24px,4vw,56px);margin:clamp(36px,5vw,56px) 0 0}
.facts div{display:grid;grid-template-columns:7.5em 1fr;gap:16px;padding:20px 0;border-top:1px solid var(--line)}
.facts dt{font-size:13px;font-weight:900;letter-spacing:.12em;color:var(--red);padding-top:3px}
.facts dd{margin:0;font-weight:700}
.facts dd small{display:block;font-weight:500;font-size:13px;color:var(--ink2)}

/* ---------- access ---------- */
.access__grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:clamp(32px,5vw,72px);align-items:start}
.floor{background:var(--paper2);border-radius:28px;padding:clamp(18px,3vw,32px)}
.floor svg{width:100%;height:auto}
.floor figcaption{font-size:12px;color:var(--ink2);margin-top:8px}
.route{list-style:none;padding:0;margin:20px 0 0;counter-reset:r;display:grid;gap:12px}
.route li{counter-increment:r;display:grid;grid-template-columns:40px 1fr;gap:12px;align-items:start;font-weight:700}
.route li::before{content:counter(r);display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--ink);color:var(--cream);font-family:var(--latin);font-size:14px}
.addr{border-top:2px solid var(--ink);padding-top:22px}
.addr h3{font-family:var(--serif);font-weight:900;font-size:clamp(22px,2.4vw,30px);margin:0 0 6px;line-height:1.4}
.addr p{margin:0 0 18px}
.ways{display:grid;gap:12px;margin:22px 0 0;padding:0;list-style:none}
.ways li{display:grid;grid-template-columns:44px 1fr;gap:12px;align-items:start;padding:16px;border-radius:18px;background:var(--paper2)}
.ways svg{width:28px;height:28px;margin:4px auto 0}
.ways b{display:block}
.ways span{font-size:14px;color:var(--ink2)}

/* ---------- faq & footer ---------- */
.faq{max-width:860px}
.faq details{border-top:1px solid var(--line)}
.faq details:last-child{border-bottom:1px solid var(--line)}
.faq summary{list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px 4px;cursor:pointer;font-weight:900;font-size:17px}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"";flex:none;width:14px;height:14px;border-right:2px solid var(--ink);border-bottom:2px solid var(--ink);rotate:45deg;translate:0 -4px;transition:rotate .3s var(--ease),translate .3s}
.faq details[open] summary::after{rotate:225deg;translate:0 4px}
.faq details p{margin:0 0 22px;padding:0 4px;color:var(--ink2)}
.foot{background:var(--ink);color:var(--cream);padding:clamp(80px,10vw,140px) 0 120px;overflow:hidden}
.foot__big{font-family:var(--serif);font-weight:900;font-size:clamp(64px,15vw,240px);line-height:1;margin:0 0 .3em;color:transparent;-webkit-text-stroke:1.5px rgba(251,243,228,.55);white-space:nowrap}
.foot__grid{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:28px}
.foot p{margin:0;font-size:14px;color:rgba(251,243,228,.8)}
.foot .brand{color:var(--cream);margin-bottom:10px}
.foot a.ig{display:inline-flex;align-items:center;gap:10px;font-weight:700;text-decoration:none;border-bottom:1.5px solid currentColor;padding-bottom:2px}
.foot small{display:block;margin-top:28px;font-size:12px;color:rgba(251,243,228,.6)}

/* mobile floating CTA */
.fab{position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom));z-index:90;display:none;transform:translateY(160%);transition:transform .5s var(--ease)}
.fab.show{transform:none}
.fab .btn{width:100%;min-height:56px;box-shadow:0 16px 30px -10px rgba(42,24,16,.55)}

/* ---------- beans（焙煎度スライダー） ---------- */
.beans{--bg:#EFE2CF;--fg:var(--ink);--sub:var(--ink2);--acc:var(--red);--bean:#A9744A;--card:rgba(255,253,249,.55);--rule:rgba(42,24,16,.18);background:var(--bg);color:var(--fg);transition:background-color .8s var(--ease),color .6s}
.beans[data-roast="1"]{--bg:#DCC4A4;--bean:#6E4128;--acc:#8E2619;--card:rgba(255,253,249,.42)}
.beans[data-roast="2"]{--bg:#2B1912;--fg:var(--cream);--sub:rgba(251,243,228,.78);--acc:var(--red-on-dark);--bean:#4A2819;--card:rgba(251,243,228,.07);--rule:rgba(251,243,228,.18)}
.beans .label{color:var(--acc)}
.beans .lead{color:var(--sub)}
.beans__grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(36px,6vw,96px);align-items:start;margin-top:clamp(36px,5vw,64px)}
.roaster{position:sticky;top:96px;display:flex;flex-direction:column;align-items:center;gap:22px}
.beanart{cursor:pointer;width:min(78%,320px);aspect-ratio:1;display:grid;place-items:center;position:relative}
.beanart::before{content:"";position:absolute;inset:6%;border-radius:50%;background:radial-gradient(circle,var(--card) 0%,transparent 70%)}
.beanart svg{width:100%;height:100%;overflow:visible;filter:drop-shadow(0 26px 30px rgba(20,10,6,.35))}
.beanart .b-body{fill:var(--bean);transition:fill .8s var(--ease)}
.beanart .b-crease{fill:none;stroke:rgba(0,0,0,.45);stroke-width:7;stroke-linecap:round}
.beanart .b-shine{fill:#fff;opacity:.16}
.beans[data-roast="2"] .beanart .b-shine{opacity:.28}
.beans[data-roast="2"] .beanart::before{background:radial-gradient(circle,rgba(238,138,115,.30) 0%,rgba(238,138,115,0) 68%)}
.beans[data-roast="2"] .beanart .b-body{stroke:rgba(251,243,228,.22);stroke-width:2}
.beanart.is-hop svg{animation:hop .7s var(--ease)}
@keyframes hop{0%{transform:rotate(0) scale(1)}40%{transform:rotate(-14deg) scale(1.06)}100%{transform:rotate(0) scale(1)}}
.roast{width:100%;max-width:420px}
.roast label{display:flex;justify-content:space-between;align-items:baseline;font-weight:900;margin-bottom:8px}
.roast label span{font-family:var(--latin);font-size:12px;letter-spacing:.24em;color:var(--acc)}
.roast input{-webkit-appearance:none;appearance:none;width:100%;height:12px;border-radius:999px;background:linear-gradient(90deg,#B98A5E,#7A4A2C 50%,#24130B);cursor:pointer;margin:10px 0}
.roast input::-webkit-slider-thumb{-webkit-appearance:none;width:34px;height:34px;border-radius:50%;background:var(--cream);border:4px solid var(--ink);box-shadow:0 6px 14px rgba(0,0,0,.3)}
.roast input::-moz-range-thumb{width:28px;height:28px;border-radius:50%;background:var(--cream);border:4px solid var(--ink)}
.roast__ticks{display:flex;justify-content:space-between;font-size:13px;font-weight:700;color:var(--sub)}
.taste{width:100%;max-width:420px;margin:0;display:grid;gap:10px}
.taste div{display:grid;grid-template-columns:3.5em 1fr;gap:12px;align-items:center}
.taste dt{font-size:13px;font-weight:900}
.taste dd{margin:0;height:10px;border-radius:999px;background:var(--rule);overflow:hidden}
.taste dd i{display:block;height:100%;width:calc(var(--v) * 20%);border-radius:999px;background:var(--acc);transition:width .8s var(--ease),background .6s}
.taste__note{font-size:12px;color:var(--sub);margin:0;max-width:420px;width:100%}
.picker{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:clamp(24px,3vw,36px)}
.picker button{display:flex;flex-direction:column;align-items:flex-start;gap:2px;padding:14px 16px;min-height:72px;border-radius:18px;border:1.5px solid var(--rule);background:var(--card);color:inherit;cursor:pointer;text-align:left;transition:border-color .3s,background .3s,transform .3s var(--ease)}
.picker button:hover{transform:translateY(-2px)}
.picker button small{font-size:12px;font-weight:700;color:var(--sub)}
.picker button b{font-family:var(--serif);font-size:20px;font-weight:900;line-height:1.3}
.picker button[aria-pressed="true"]{border-color:var(--fg);background:var(--fg);color:var(--bg)}
.picker button[aria-pressed="true"] small{color:inherit;opacity:.8}
.bean__roast{display:inline-flex;align-items:center;gap:10px;margin:0;font-weight:900;color:var(--acc)}
.bean__roast i{font-style:normal;font-family:var(--latin);font-size:12px;letter-spacing:.28em}
.bean__name{font-family:var(--serif);font-weight:900;font-size:clamp(48px,7vw,104px);line-height:1.08;margin:.12em 0 0;letter-spacing:.02em}
.bean__en{font-family:var(--latin);font-weight:700;font-size:13px;letter-spacing:.4em;color:var(--sub);margin:4px 0 0}
.bean__lot{font-family:var(--serif);font-weight:700;font-size:clamp(17px,1.6vw,21px);margin:14px 0 0;text-wrap:balance}
.notes-chips{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0;padding:0;list-style:none}
.notes-chips li{padding:5px 14px;border-radius:999px;border:1.5px solid var(--fg);font-size:14px;font-weight:700}
.bean__profile{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px;margin:0 0 24px;border-top:1.5px solid var(--fg)}
.bean__profile div{padding:12px 0;border-bottom:1px solid var(--rule)}
.bean__profile dt{font-family:var(--latin);font-size:11px;font-weight:700;letter-spacing:.24em;color:var(--acc)}
.bean__profile dd{margin:2px 0 0;font-weight:700}
.bean__h{font-family:var(--latin);font-size:12px;font-weight:700;letter-spacing:.3em;color:var(--acc);margin:22px 0 6px}
.bean__p{margin:0;font-size:15.5px;line-height:1.95;color:var(--fg);text-wrap:pretty}
.bean__rec{display:flex;gap:14px;align-items:flex-start;margin-top:26px;padding:18px 20px;border-radius:18px;background:var(--card);border:1px solid var(--rule)}
.bean__rec b{flex:none;font-family:var(--latin);font-size:11px;letter-spacing:.24em;color:var(--acc);padding-top:3px}
.bean__rec p{margin:0;font-weight:700}
.bean-swap{animation:swap .6s var(--ease)}
@media (max-width: 900px){
  .beans__grid{grid-template-columns:1fr}
  .roaster{position:static}
  .beanart{width:min(60%,260px)}
}
@media (max-width: 640px){
  .picker{grid-template-columns:1fr}
  .picker button{flex-direction:row;align-items:baseline;gap:12px;min-height:56px}
  .bean__profile{grid-template-columns:1fr}
}

/* ---------- responsive ---------- */
@media (max-width: 1080px){
  .toys{grid-template-columns:1fr}
}
@media (max-width: 900px){
  .burger{display:block;position:relative;z-index:2}
  .nav{position:fixed;inset:0;z-index:1;flex-direction:column;justify-content:center;gap:26px;background:var(--paper);opacity:0;visibility:hidden;transition:opacity .35s,visibility .35s}
  .nav-open .nav{opacity:1;visibility:visible}
  .nav a:not(.btn){font-size:16px}
  .nav .btn{min-height:56px;font-size:16px;padding:0 36px}
  .concept__grid,.menu__grid,.access__grid{grid-template-columns:1fr}
  .photos{max-width:520px;width:100%;margin-inline:auto}
  .points{grid-template-columns:1fr;gap:22px}
  .facts{grid-template-columns:1fr}
  .fab{display:block}
}
@media (max-width: 860px){
  .hero__photo{position:relative;width:100%;height:64vh;height:64svh;clip-path:inset(0 0 100% 0)}
  .hero__photo::after{content:"";position:absolute;inset:auto 0 0 0;height:40%;background:linear-gradient(to bottom,rgba(243,237,227,0),var(--paper));z-index:1}
  .hero__copy{min-height:0;padding:0 var(--pad) 64px;margin-top:-.62em}
  .hero__title{font-size:15.6vw;position:relative;z-index:2}
  .hero__eyebrow,.hero__meta{max-width:none}
  .hero__eyebrow{order:2;margin-top:4px}
  .hero__title{order:1}
  .hero__sub{order:3}.hero__meta{order:4}.hero__cta{order:5}
  .badge{left:auto;right:14px;top:calc(64svh - 150px);bottom:auto;width:128px;height:128px}
  .badge__logo{width:64px}
  .scrollcue{display:none}
  .scenes__track{overflow-x:auto;scroll-snap-type:x mandatory;width:auto;padding-bottom:12px;scrollbar-width:none}
  .scenes__track::-webkit-scrollbar{display:none}
  .scene{scroll-snap-align:center}
  .menu__media{max-width:440px;width:100%;margin-inline:auto}
}
@media (max-width: 640px){
  body{font-size:15px}
  .brand span{font-size:15px}
  .hero__cta .btn{flex:1 1 100%}
  .dates{grid-template-columns:1fr}
  .facts div{grid-template-columns:1fr;gap:4px}
  .promo__join{grid-template-columns:1fr;justify-items:start}
  .promo__head{flex-direction:column-reverse;gap:6px}
  .promo__fan{width:150px;height:124px}
  .toggle button{min-width:96px}
  .price div+div{padding-left:16px}
}
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
  .js .reveal{opacity:1;transform:none}
}
</style>
</head>
