    <img class="badge__logo" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-asset="logo.webp" alt="">
  </div>

  <a class="scrollcue" href="#concept">SCROLL <i></i></a>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee__track" id="marquee">
    <div class="marquee__item">
      <span>もう飲んだ？</span><svg class="bean" viewBox="0 0 24 24"><ellipse cx="12" cy="12" rx="8" ry="11" transform="rotate(30 12 12)" fill="#EE8A73"/><path d="M8 4c4 4 4 12 8 16" stroke="#2A1810" stroke-width="1.6" fill="none" transform="rotate(30 12 12)"/></svg>
